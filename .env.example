# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB (same database the client's BetterAuth uses)
CS_MONGODB_URI=
CS_DB_NAME=fixmate

# Must match CS_JWT_SECRET in fixmate-client/.env.local
CS_JWT_SECRET=

# Client origin(s)
CS_CLIENT_URL=http://localhost:3000
CS_CORS_ORIGINS=http://localhost:3000

# Stripe (test mode)
CS_STRIPE_SECRET_KEY=
CS_STRIPE_WEBHOOK_SECRET=

# ImgBB
CS_IMGBB_API_KEY=
